# 复制为 .env 并填入真实值。.env 已 gitignore，永远不要提交。
# 部署到 Vercel 时，把下面标注「必填」的项填进项目的环境变量面板。

# ---- 百度翻译（既有）----
# 账号需为高级版：标准版 QPS=1，高级版（个人认证后）QPS=10。
# 高级版免费额度 200 万字符/月；标准版仅 5 万字符/月。
# 未认证就调高并发会返回 54003「访问频率受限」。
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# ---- 翻译并发与批量（新增）----
# 百度支持在 q 字段用换行符一次提交多段文本，按行返回对应译文，
# 因此这里是「批量 + 限速并发」而不是「逐句请求」。
# 实测：一集 12.5 分钟播客 239 句 -> 6 次请求，翻译阶段约 0.6 秒（原为 239 秒以上）。
# TRANSLATE_QPS=10              # 每秒请求上限：标准版填 1，高级版 10，尊享版 100
# TRANSLATE_MAX_WORKERS=6       # 并发线程数，一般不超过 QPS 即可
# TRANSLATE_BATCH_CHARS=1500    # 单次请求累计字符上限（官方建议 2000 以内，认证后上限 6000）

# ---- 口令闸门（必填，缺了整站 503）----
# src/proxy.ts 是 fail-closed：PASSPHRASE / AUTH_SECRET 任一为空就拒绝所有访问。
# AUTH_SECRET 只用于给 Cookie 签名，随便一串长随机值即可（openssl rand -hex 32）。
PASSPHRASE=
AUTH_SECRET=

# ---- ASR 引擎选择 ----
# whisper = 本地 Whisper（免费、无额度上限，走本机 CPU）
# tencent = 云端一句话识别（每月 5000 次免费，超出约 ¥0.003/次）
ASR_ENGINE=whisper
# base（145MB，9.9× 实时，法语差）| small（483MB，3.7× 实时，法语准确）| medium | large-v3-turbo
# 实测同一份 874s 语料：base 把 "Les loisirs et les activités" 转成 "Léger times activities"，
# small 转成 "Leisure time activities, our likes and dislikes"（正确）。默认用 small。
WHISPER_MODEL=small
# 双遍裁决：实测仅 13/205 行有实质差异、却要多花 1.77× 时间，默认关闭
WHISPER_BILINGUAL=0
# 单句时长上限（秒）：超过就切开，保证精听定位粒度
WHISPER_MAX_SEGMENT_SEC=12
# 词间静音超过该值即视为句子边界
WHISPER_WORD_GAP_SEC=0.6
# CPU 推理线程数，留空自动取 min(8, cpu_count)
# WHISPER_THREADS=8
# Whisper 幻觉抑制阈值（默认 0.6，调高更保守）
# WHISPER_NO_SPEECH_THRESHOLD=0.6

# ---- 腾讯云语音识别（仅在 ASR_ENGINE=tencent 时需要）----
# 用于「一句话识别 SentenceRecognition」，按 VAD 语音段逐段识别。
# 控制台：https://console.cloud.tencent.com/cam/capi
# 免费额度：每月 5000 次；超出后约 ¥0.003/次。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-shanghai

# ═══════════════════════════════════════════════════════════════════════
#  阶段二：Supabase（云端持久化）
#
#  数据库与对象存储都在 Supabase 免费版上。这些变量**只给服务端用**：
#    · Next Route Handlers（Vercel 环境变量）
#    · 本机 worker（.env）
#  浏览器端一个都不需要 —— 所以**没有** NEXT_PUBLIC_SUPABASE_ANON_KEY 这一项，
#  别去加它：本项目 RLS 是「开启 + 零策略」，anon key 连上去什么都读不到，
#  加了只会让人误以为要从前端直连数据库。
# ═══════════════════════════════════════════════════════════════════════

# Dashboard → Project Settings → API → Project URL，形如 https://<ref>.supabase.co
# ⚠️ 必须 https:// 开头（worker 启动时会校验，写错直接拒绝启动）
SUPABASE_URL=
# Dashboard → Project Settings → API → service_role（以 eyJ 开头的长 JWT）
# ⚠️ 不是 anon / publishable！service_role 绕过 RLS，泄露等于库裸奔，
#    只放服务端环境变量，**永远不要加 NEXT_PUBLIC_ 前缀**，也不要提交进 git。
SUPABASE_SERVICE_ROLE_KEY=
# 私有 bucket 名，与 supabase/schema.sql 里创建的一致
SUPABASE_STORAGE_BUCKET=podcast-audio

# ---- 本机 worker ----
# 会写进 podcasts.locked_by 与 worker_heartbeat.worker_id。
# 多台机器同时跑时必须各不相同；留空自动取「主机名-PID」。
# WORKER_ID=
# 空轮询间隔（秒）。调小烧 Supabase 免费请求数，调大则上传后要等更久才开工。
# WORKER_POLL_SECONDS=5
# 心跳间隔（秒）。它同时负责 Supabase 保活（免费项目 7 天无活动休眠），别调太长。
# WORKER_HEARTBEAT_SECONDS=5
# 转写完成后把音频压到 64kbps 单声道再回传，体积约为原来的 15%
# （免费版 Storage 只有 1GB，不压只够存 10~20 集）。置 0 关闭。
# AUDIO_COMPRESS=1
# AUDIO_BITRATE=64k
# 音频中转目录，处理完即删
# WORKER_TMP_DIR=

# ---- 可选调参 ----
# VAD 参数（实测默认值：段/句≈1.0，句起点中位误差 0.42~0.52s，≤1s 占比 74~85%）
# VAD_AGGRESSIVENESS=3
# VAD_MIN_SPEECH_MS=250
# VAD_MERGE_GAP_MS=250          # 调小到 150 时间戳更准（中位 0.41s / p90 1.19s），但调用数约多 20%
# VAD_MERGE_BY_PUNCT=0          # 置 1 会把缺句末标点的相邻行合并；依赖 ASR 返回标点，默认关闭
# ASR_MAX_WORKERS=16            # 一句话识别默认 QPS 上限 30
# TIMESTAMP_DECIMALS=0          # 0 -> "1:23"；1 -> "1:23.4"（前端解析器支持小数）
# ALLOWED_ORIGINS=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════
#  本地 FastAPI 转发（**只给本地开发用**）
#
#  阶段二之后前端走 src/app/api/** 的 Route Handlers，不再依赖 FastAPI。
#  但本地那套 FastAPI + Whisper 的完整闭环在调试转写/翻译管线时仍然好用，
#  所以保留转发能力，用一个显式开关隔离。
#
#  ⚠️ Vercel 上**不要设**这个变量：那边没有 FastAPI，
#     转发只会把 /health、/docs 之类的请求打到不存在的 127.0.0.1:8000。
#
#  注意 `/api/*` 永远不转发 —— 那是 Route Handlers 的地盘。
#  next.config.ts 用的是 beforeFiles rewrite，它跑在文件系统路由**之前**，
#  所以只要转发 /api/*，所有 Route Handler 都会被遮蔽而永不执行。
# ═══════════════════════════════════════════════════════════════════════
# LOCAL_FASTAPI=1

# 本地 FastAPI 的地址（仅在 LOCAL_FASTAPI=1 时有意义）
# BACKEND_ORIGIN=http://127.0.0.1:8000
